# Не класти в ~/.config/autostart/, якщо увімкнено layout-fix.service.
[Desktop Entry]
Type=Application
Name=Layout Fix
Comment=Виправляє слово, набране не в тій розкладці
Exec=@CMAKE_INSTALL_FULL_BINDIR@/layout-fix
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=false
OnlyShowIn=X-Cinnamon;