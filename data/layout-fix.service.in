# Єдиний автозапуск. data/layout-fix.desktop у ~/.config/autostart/ не копіювати.
[Unit]
Description=Виправлення помилкової розкладки клавіатури
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/layout-fix
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target